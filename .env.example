# Public app origin used by Better Auth. Local default is http://localhost:3000.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=studiospace
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Express origin used by Next.js rewrite. In production use your Render API URL.
SERVER_ORIGIN=http://localhost:5000
# Optional ImgBB API key. Without it, paste hosted image URLs into the form.
NEXT_PUBLIC_IMGBB_API_KEY=
# Optional examiner convenience button; use a disposable assessment account only.
NEXT_PUBLIC_EXAMINER_EMAIL=examiner@studiospace.demo
NEXT_PUBLIC_EXAMINER_PASSWORD=StudioSpace@2026
API_COOKIE_NAME=studiospace_access
