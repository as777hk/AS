# Local frontend configuration (place in client/.env.local).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=studiospace
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_SERVER_URL=http://localhost:4000

# Google OAuth. Add the local callback URL to the OAuth client when testing locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-side email delivery. Signup email verification must remain disabled.
RESEND_API_KEY=
AUTH_FROM_EMAIL=
EMAIL_2FA_ENABLED=false
# Leave this off for the assignment; it enables a separate passwordless email sign-in flow.
NEXT_PUBLIC_EMAIL_OTP_ENABLED=false

# Optional server-side image uploads. Never use a NEXT_PUBLIC_ prefix.
IMGBB_API_KEY=

# Public examiner convenience email only; never put a real user's password here.
NEXT_PUBLIC_EXAMINER_EMAIL=examiner@studiospace.demo
